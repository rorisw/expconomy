# Normalize line endings on commit.
* text=auto eol=lf

# Windows scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Unix scripts keep LF.
gradlew text eol=lf
*.sh text eol=lf

# Binaries.
*.jar binary
*.png binary
*.gif binary
*.ico binary

# Keep the Gradle wrapper jar out of language stats and diffs.
gradle/wrapper/gradle-wrapper.jar binary linguist-vendored
